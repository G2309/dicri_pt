{
	"info": {
		"name": "DICRI API",
		"description": "API para Sistema de Gestión de Evidencias DICRI",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:4000/api",
			"type": "string"
		},
		{
			"key": "token",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    pm.collectionVariables.set('token', jsonData.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n\t\"username\": \"tecnico1\",\n\t\"password\": \"tec123\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "login"]
						}
					}
				},
				{
					"name": "Get Current User",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/auth/me",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "me"]
						}
					}
				}
			]
		},
		{
			"name": "Expedientes",
			"item": [
				{
					"name": "Crear Expediente",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n\t\"numeroExpediente\": \"EXP-2025-001\",\n\t\"descripcion\": \"Robo en zona 10\",\n\t\"ubicacion\": \"Calle Principal, Zona 10\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/expedientes",
							"host": ["{{baseUrl}}"],
							"path": ["expedientes"]
						}
					}
				},
				{
					"name": "Listar Expedientes",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/expedientes?estado=Borrador",
							"host": ["{{baseUrl}}"],
							"path": ["expedientes"],
							"query": [
								{
									"key": "estado",
									"value": "Borrador"
								},
								{
									"key": "fechaInicio",
									"value": "2025-01-01",
									"disabled": true
								},
								{
									"key": "fechaFin",
									"value": "2025-12-31",
									"disabled": true
								}
							]
						}
					}
				},
				{
					"name": "Obtener Expediente por ID",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/expedientes/1",
							"host": ["{{baseUrl}}"],
							"path": ["expedientes", "1"]
						}
					}
				},
				{
					"name": "Actualizar Expediente",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n\t\"numeroExpediente\": \"EXP-2025-001\",\n\t\"descripcion\": \"Robo en zona 10 - Actualizado\",\n\t\"ubicacion\": \"Calle Principal, Zona 10\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/expedientes/1",
							"host": ["{{baseUrl}}"],
							"path": ["expedientes", "1"]
						}
					}
				},
				{
					"name": "Enviar a Revisión",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/expedientes/1/revision",
							"host": ["{{baseUrl}}"],
							"path": ["expedientes", "1", "revision"]
						}
					}
				}
			]
		},
